<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>J.A.R.V.I.S.</title>
<style>
:root{--bg:#f3f7fa;--card:#ffffff;--ink:#0b2a3a;--mut:#4d6b7a;--ac:#0a86b8;--line:#bcd6e2;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#04121c;--card:#08202e;--ink:#d8f6ff;--mut:#7fb3c7;--ac:#2fd4ff;--line:#0f4056}}
:root[data-theme="dark"]{--bg:#04121c;--card:#08202e;--ink:#d8f6ff;--mut:#7fb3c7;--ac:#2fd4ff;--line:#0f4056}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100%}
.wrap{max-width:760px;margin:0 auto;padding:16px}
header{display:flex;align-items:center;gap:14px}
.core{width:64px;height:64px;border-radius:50%;border:3px solid var(--ac);position:relative;flex:none;animation:spin 8s linear infinite;box-shadow:0 0 18px var(--ac)}
.core::before{content:"";position:absolute;inset:10px;border-radius:50%;border:2px dashed var(--ac)}
.core::after{content:"";position:absolute;inset:23px;border-radius:50%;background:var(--ac);box-shadow:0 0 14px var(--ac);animation:pulse 2s ease-in-out infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{50%{opacity:.35}}
h1{margin:0;font-size:20px;letter-spacing:.2em}
#greet{color:var(--mut);font-size:14px}
#clock{margin-left:auto;text-align:right;font-variant-numeric:tabular-nums;font-size:22px;color:var(--ac)}
#date{display:block;font-size:12px;color:var(--mut)}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-top:14px}
h2{margin:0 0 10px;font-size:12px;letter-spacing:.18em;color:var(--mut);font-weight:600}
.cmd{display:flex;gap:8px}
input{flex:1;min-width:0;background:transparent;border:1px solid var(--line);border-radius:10px;padding:12px;color:var(--ink);font-size:16px}
button{background:var(--ac);color:var(--bg);border:0;border-radius:10px;padding:0 14px;font-weight:700;font-size:15px;min-height:44px}
button.ghost{background:transparent;color:var(--ac);border:1px solid var(--ac)}
#mic.on{animation:pulse 1s infinite}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:10px}
.tile{border:1px solid var(--line);border-radius:12px;padding:14px 6px;text-align:center;font-size:13px;color:var(--ink);background:transparent;min-height:72px;position:relative}
.tile:active{border-color:var(--ac);box-shadow:0 0 10px var(--ac)}
.tile i{display:block;font-style:normal;font-size:24px;margin-bottom:4px}
.tile .x{position:absolute;top:2px;right:6px;color:var(--mut);font-size:14px}
#log{font-size:14px;max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:6px}
#log div{border-left:2px solid var(--ac);padding-left:8px}
#log .me{color:var(--mut)}
.add{display:grid;grid-template-columns:1fr 1.4fr auto;gap:8px}
.hint{font-size:12px;color:var(--mut);margin-top:8px}
ul{margin:0;padding-left:18px;font-size:14px}
</style>
</head>
<body>
<div class="wrap">
<header>
<div class="core"></div>
<div><h1>J.A.R.V.I.S.</h1><div id="greet"></div></div>
<div id="clock"><span id="t"></span><span id="date"></span></div>
</header>

<div class="card">
<h2>COMMAND</h2>
<div class="cmd"><input id="in" placeholder="Try: open gmail, note buy milk, time" autocomplete="off"><button id="mic" class="ghost" aria-label="Voice">🎤</button><button id="go">Go</button></div>
<div id="log" style="margin-top:10px"></div>
</div>

<div class="card">
<h2>CONNECTED APPS</h2>
<div class="grid" id="apps"></div>
<div class="add" style="margin-top:12px">
<input id="an" placeholder="App name"><input id="au" placeholder="https://…" inputmode="url"><button id="ab">Add</button>
</div>
<div class="hint">Tap a tile or say “open &lt;app&gt;”. Add any app by name and link.</div>
</div>

<div class="card">
<h2>NOTES</h2>
<ul id="notes"></ul>
<div class="hint">Say “note …” to add. Say “clear notes” to wipe.</div>
</div>
</div>

<script>
const $=id=>document.getElementById(id);
const DEF=[
{n:"Gmail",s:"googlegmail://",u:"https://mail.google.com",e:"✉️"},
{n:"Calendar",s:"googlecalendar://",u:"https://calendar.google.com",e:"📅"},
{n:"YouTube",s:"youtube://",u:"https://www.youtube.com",e:"▶️"},
{n:"WhatsApp",s:"whatsapp://",u:"https://web.whatsapp.com",e:"💬"},
{n:"Spotify",s:"spotify://",u:"https://open.spotify.com",e:"🎵"},
{n:"Maps",s:"comgooglemaps://",u:"https://maps.google.com",e:"🗺️"}];
let apps=DEF.slice(),notes=[];
function load(){try{const a=localStorage.getItem("jv_apps");if(a)apps=JSON.parse(a).map(x=>{const d=DEF.find(y=>y.n===x.n);return x.s||!d?x:{...x,s:d.s}});const n=localStorage.getItem("jv_notes");if(n)notes=JSON.parse(n)}catch(e){}}
function save(){try{localStorage.setItem("jv_apps",JSON.stringify(apps));localStorage.setItem("jv_notes",JSON.stringify(notes))}catch(e){}}
function log(t,me){const d=document.createElement("div");if(me)d.className="me";d.textContent=t;$("log").appendChild(d);$("log").scrollTop=1e5}
function say(t){log(t);try{const u=new SpeechSynthesisUtterance(t);speechSynthesis.speak(u)}catch(e){}}
function render(){
$("apps").innerHTML="";
apps.forEach((a,i)=>{const b=document.createElement("a");b.className="tile";b.href=href(a);b.target="_top";b.style.textDecoration="none";b.innerHTML='<i></i><span></span><span class="x">×</span>';
b.querySelector("i").textContent=a.e||"🔗";b.querySelector("span").textContent=a.n;
b.onclick=ev=>{if(ev.target.className==="x"){ev.preventDefault();apps.splice(i,1);save();render()}};$("apps").appendChild(b)});
$("notes").innerHTML="";notes.forEach(n=>{const l=document.createElement("li");l.textContent=n;$("notes").appendChild(l)});
}
function openUrl(u,n){let w=null;try{w=window.open(u,"_blank")}catch(e){}if(w)return;const d=document.createElement("div");d.append("Pop-up blocked. Tap: ");[["_blank","new tab"],["_top","this tab"]].forEach(([t,l])=>{const a=document.createElement("a");a.href=u;a.target=t;a.rel="noopener";a.textContent=n+" ("+l+")";a.style.cssText="color:var(--ac);margin-right:10px";d.appendChild(a)});$("log").appendChild(d);$("log").scrollTop=1e5}
const AND=/android/i.test(navigator.userAgent);const PK={Gmail:"com.google.android.gm",Calendar:"com.google.android.calendar",YouTube:"com.google.android.youtube",WhatsApp:"com.whatsapp",Spotify:"com.spotify.music",Maps:"com.google.android.apps.maps"};
function href(a){if(AND&&PK[a.n])return "intent://#Intent;package="+PK[a.n]+";end";return a.s||a.u}
function openApp(a){say("Opening "+a.n+".");const x=document.createElement("a");x.href=href(a);x.target="_top";document.body.appendChild(x);x.click();x.remove()}
function run(raw){
const c=raw.trim();if(!c)return;log("› "+c,true);const l=c.toLowerCase();
if(/^(open|launch|start)\s+/.test(l)){const q=l.replace(/^(open|launch|start)\s+/,"");const a=apps.find(x=>x.n.toLowerCase()===q)||apps.find(x=>x.n.toLowerCase().includes(q)||q.includes(x.n.toLowerCase()));return a?openApp(a):say("I don’t have "+q+" connected yet. Add it below.")}
if(/^note\s+/.test(l)){notes.push(c.replace(/^note\s+/i,""));save();render();return say("Note saved.")}
if(l==="clear notes"){notes=[];save();render();return say("Notes cleared.")}
if(/time/.test(l))return say("It is "+new Date().toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"})+".");
if(/date|day/.test(l))return say("Today is "+new Date().toLocaleDateString([], {weekday:"long",month:"long",day:"numeric"})+".");
if(/^(search|google)\s+/.test(l)){const q=c.replace(/^(search|google)\s+/i,"");say("Searching for "+q+".");return openUrl("https://www.google.com/search?q="+encodeURIComponent(q),"Google")}
if(/hello|hi|hey/.test(l))return say("At your service.");
say("I didn’t catch that. Try “open gmail”, “note …”, “search …” or “time”.")}
$("go").onclick=()=>{run($("in").value);$("in").value=""};
$("in").onkeydown=e=>{if(e.key==="Enter")$("go").click()};
$("ab").onclick=()=>{let n=$("an").value.trim(),u=$("au").value.trim();if(!n||!u)return;if(!/^https?:\/\//.test(u))u="https://"+u;apps.push({n,u,e:"🔗"});$("an").value=$("au").value="";save();render()};
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
if(SR){const r=new SR();r.lang="en-US";r.onresult=e=>{$("mic").classList.remove("on");run(e.results[0][0].transcript)};r.onend=()=>$("mic").classList.remove("on");r.onerror=()=>$("mic").classList.remove("on");
$("mic").onclick=()=>{try{r.start();$("mic").classList.add("on")}catch(e){}}}else $("mic").style.display="none";
function tick(){const d=new Date();$("t").textContent=d.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"});$("date").textContent=d.toLocaleDateString([], {weekday:"short",month:"short",day:"numeric"});const h=d.getHours();$("greet").textContent=(h<12?"Good morning":h<18?"Good afternoon":"Good evening")+". All systems online."}
load();render();tick();setInterval(tick,15000);log("J.A.R.V.I.S. online. How can I help?");
</script>
</body.
</html>
